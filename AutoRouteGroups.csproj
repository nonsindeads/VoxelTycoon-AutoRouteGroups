<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AutoRouteGroups</AssemblyName>
    <RootNamespace>AutoRouteGroups</RootNamespace>
    <VoxelTycoonManagedDirectory Condition="'$(VoxelTycoonManagedDirectory)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/VoxelTycoon/VoxelTycoon.app/Contents/Resources/Data/Managed</VoxelTycoonManagedDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Reference Include="VoxelTycoon">
      <HintPath>$(VoxelTycoonManagedDirectory)/VoxelTycoon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VoxelTycoonManagedDirectory)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="preview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateVoxelTycoonManagedDirectory" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(VoxelTycoonManagedDirectory)/VoxelTycoon.dll')"
      Text="VoxelTycoon.dll was not found. Set VoxelTycoonManagedDirectory to the game's Managed directory." />
  </Target>
</Project>
